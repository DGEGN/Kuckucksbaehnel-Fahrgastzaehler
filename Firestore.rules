rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Eine Fahrt = ein Fahrtag an einem Standort (Dokument-ID: "YYYY-MM-DD_standort")
    match /fahrten/{fahrtId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['fahrtag', 'standort', 'sitzplaetze', 'einzelperson', 'familien', 'gruppen'])
        && request.resource.data.sitzplaetze is int
        && request.resource.data.sitzplaetze > 0
        && request.resource.data.standort in ['neustadt', 'lambrecht'];

      // Zählstände werden per increment()/updateDoc laufend aktualisiert
      allow update: if request.auth != null;

      // Fahrten werden nie gelöscht, nur zurückgesetzt (Zählstände auf 0)
      allow delete: if false;

      // Live-Aktivitätsprotokoll je Fahrt
      match /ereignisse/{eventId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['kategorie', 'anzahl', 'kasse'])
          && request.resource.data.kategorie in ['einzelperson', 'familien', 'gruppen', 'erwachsene', 'kinder'];

        // Löschen wird für "Rückgängig" und "Zurücksetzen" benötigt
        allow delete: if request.auth != null;
        allow update: if false;
      }
    }
  }
}
