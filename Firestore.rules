rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Benutzerprofile: legt bei der Registrierung die Rolle fest
    // (bearbeiter | betrachter). Jede/r kann nur das eigene Profil
    // lesen und beim Erstellen selbst befüllen.
    // ---------------------------------------------------------
    match /benutzer/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'rolle'])
        && request.resource.data.rolle in ['bearbeiter', 'betrachter'];

      // Profile werden nach dem Anlegen nicht mehr verändert oder gelöscht
      allow update: if false;
      allow delete: if false;
    }

    // Liest die Rolle des aktuell angemeldeten Kontos aus dessen Profil.
    function istBearbeiter() {
      return request.auth != null
        && get(/databases/$(database)/documents/benutzer/$(request.auth.uid)).data.rolle == 'bearbeiter';
    }

    // Eine Fahrt = ein Fahrtag an einem Standort (Dokument-ID: "YYYY-MM-DD_standort")
    match /fahrten/{fahrtId} {
      // Lesen dürfen beide Rollen (Betrachter braucht das für die Sitzplatzanzeige)
      allow read: if request.auth != null;

      allow create: if istBearbeiter()
        && request.resource.data.keys().hasAll(
             ['fahrtag', 'standort', 'sitzplaetze', 'einzelperson', 'familien', 'gruppen'])
        && request.resource.data.sitzplaetze is int
        && request.resource.data.sitzplaetze > 0
        && request.resource.data.standort in ['neustadt', 'lambrecht'];

      // Zählstände werden per increment()/updateDoc laufend aktualisiert
      allow update: if istBearbeiter();

      // Fahrten können über die App gelöscht werden (inkl. ihres Aktivitätsprotokolls)
      allow delete: if istBearbeiter();

      // Live-Aktivitätsprotokoll je Fahrt
      match /ereignisse/{eventId} {
        allow read: if request.auth != null;

        allow create: if istBearbeiter()
          && request.resource.data.keys().hasAll(['kategorie', 'anzahl', 'kasse'])
          && request.resource.data.kategorie in ['einzelperson', 'familien', 'gruppen', 'erwachsene', 'kinder'];

        // Löschen wird für "Rückgängig" und "Zurücksetzen" benötigt
        allow delete: if istBearbeiter();
        allow update: if false;
      }
    }
  }
}
